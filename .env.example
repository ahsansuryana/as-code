# MCP Server Configuration
PORT=3000

# Your publicly accessible URL (Cloudflare tunnel URL or domain)
# Example: https://abc123.trycloudflare.com
# Used for OAuth discovery and issuer metadata
PUBLIC_URL=https://your-tunnel-url.trycloudflare.com

# Bearer token for HTTP auth — generate with: openssl rand -hex 32
BEARER_TOKEN=your-secret-token-here

# Absolute path to the project root that the agent is allowed to access
PROJECT_ROOT=F:/my-project

# Permission mode: manual | scoped-auto | bypass
PERMISSION_MODE=manual

# Tool Profile: full | read-only | compat-readonly-all
# full: all tools exposed
# read-only: destructive tools (write_file, edit_file, exec_command, etc.) omitted from tool list
# compat-readonly-all: all tools exposed with readOnlyHint: true (NOT a secure mode)
MCP_TOOL_PROFILE=full

# Skip explicit permission prompts (default false). Set true only in trusted dev environments.
MCP_SKIP_PERMISSIONS=false

# Watchdog timeout for background execution sessions in ms (default 30 mins = 1800000)
SESSION_WATCHDOG_TIMEOUT_MS=1800000

# Command allowlist for exec_command / run_command (comma-separated executable names)
COMMAND_ALLOWLIST=npm,git,node,npx,python,python3

# Max timeout for blocking exec_command in ms (ceiling)
COMMAND_TIMEOUT_CEILING_MS=600000

# SQLite audit log path
AUDIT_DB_PATH=./data/audit.db

# Optional: web_fetch domain allowlist (comma-separated, empty = block all)
WEB_FETCH_ALLOWLIST=

# Optional: bind address (default localhost — keep as-is when using Cloudflare Tunnel)
BIND_ADDRESS=127.0.0.1
